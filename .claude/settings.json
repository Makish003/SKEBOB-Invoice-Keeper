{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "mcp__motion"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
