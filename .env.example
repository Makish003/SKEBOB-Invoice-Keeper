# Invoice Keeper — пример настроек. Скопируйте в .env: cp .env.example .env (PowerShell: Copy-Item .env.example .env)
# Комментарии — только на отдельных строках.

# --- App ---
# development | production
APP_ENV=development
# Единый часовой пояс приложения: в нём считается «сегодня» (FR-3)
APP_TIMEZONE=Europe/Moscow
# Секрет для подписи кнопок Telegram — замените на случайную строку (64 символа)
SECRET_KEY=change-me-to-random-64-chars
# Порт веб-панели на хосте: http://localhost:8080
WEB_PORT=8080
# true, если панель открыта по HTTPS
COOKIE_SECURE=false
# Только для deploy/compose.https.yml: домен сервера, на него Caddy получит сертификат
# DOMAIN=invoice-keeper.duckdns.org
SESSION_TTL_HOURS=168
# Заполнить пустую БД демо-данными при первом старте
SEED_DEMO_DATA=true
# Только при APP_ENV=development: подменить «сегодня» (YYYY-MM-DD) для демонстрации следующего периода
CLOCK_OVERRIDE=

# --- Admin (FR-12): единственный администратор, задаётся здесь ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# --- Database ---
POSTGRES_DB=invoice_keeper
POSTGRES_USER=invoice_keeper
POSTGRES_PASSWORD=invoice_keeper
# Необязательно: по умолчанию строка подключения собирается из POSTGRES_* (хост db)
# DATABASE_URL=postgresql+psycopg://invoice_keeper:invoice_keeper@db:5432/invoice_keeper

# --- Reminders ---
# За сколько дней до срока напоминать
REMINDER_DAYS_BEFORE=3
REMINDER_CHECK_INTERVAL_SECONDS=60
PENDING_POLL_SECONDS=5
GENERATION_HORIZON_DAYS=35
REMINDER_MAX_ATTEMPTS=5
# Напоминаний о просрочке на период (раз в день, пока не оплачен); 0 — выключить
OVERDUE_REMINDER_MAX=3
# О более старых просрочках не напоминать (дней)
OVERDUE_REMINDER_WINDOW_DAYS=30

# --- Telegram (пусто = напоминания пишутся в лог воркера: docker compose logs worker) ---
TELEGRAM_BOT_TOKEN=
# Один id или несколько через запятую: группа (-100…) и/или личные чаты (положительный id, человек сначала жмёт «Запустить»)
TELEGRAM_CHAT_ID=
# Адрес панели для кнопок бота «Открыть в панели». Пусто — https://DOMAIN или http://localhost:WEB_PORT
# (localhost Telegram в кнопках не принимает: бот покажет адрес текстом и кнопку «Скопировать»)
PUBLIC_URL=

# --- Бонусы (необязательно) ---
WEBHOOK_URL=
WEBHOOK_SECRET=
# Email-напоминания: для демо SMTP_HOST=mailpit и EMAIL_TO=team@example.com, затем
# docker compose --profile extras up -d  → письма видны на http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=invoice-keeper@example.com
# Получатели через запятую
EMAIL_TO=
